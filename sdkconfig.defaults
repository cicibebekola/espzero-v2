# ── Bluetooth Classic + A2DP source only ──
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_SOURCE_ENABLE=y
CONFIG_BT_AVRCP_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
CONFIG_BT_BTU_TASK_STACK_SIZE=3072
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ── Memory optimization ──
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2048

# ── LVGL 9 (managed by esp_lvgl_port + LVGL Kconfig) ──
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# ── Flash ──
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ── Partition table ──
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── C runtime ──
CONFIG_HTTPD_MAX_URI_LEN=2048
CONFIG_NEWLIB_STDOUT_LINEENDING_CRLF=y
CONFIG_NEWLIB_STDIN_LINEENDING_CR=y
